table _Measures
	lineageTag: d752c61f-cb30-4105-a95b-fdf945d4f2c8

	measure 'Total Revenue' = SUM(FactOrders[sales])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 23ef1361-f89d-474d-8e26-227aa7d6ca64

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' = SUM(FactOrders[order_profit_per_order])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 02371093-1ac0-4688-bcf6-defe51831cdc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Net Margin %' = DIVIDE([Total Profit], [Total Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9cb2983b-9e51-4199-a11a-f0a9c789264c

	measure 'Total Orders' = COUNTROWS(FactOrders)
		formatString: 0
		lineageTag: d154633f-6e3c-4515-8911-e7d069bf5093

	measure 'Late Delivery Rate' = AVERAGE(FactOrders[late_delivery_risk])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 75172df4-37cb-4d6d-ad8e-862746c07de2

	measure 'Avg Shipping Delay' = AVERAGE(FactOrders[shipping_delay_days])
		lineageTag: a581a7dc-77d9-4863-870a-9f9318e67851

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Loss Order Count' = COUNTROWS(FILTER(FactOrders, FactOrders[order_profit_per_order] < 0))
		formatString: 0
		lineageTag: d3479d8a-8833-47ce-979b-f79863022ac5

	measure 'Loss Order %' = DIVIDE([Loss Order Count], [Total Orders])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b3cb26e7-5712-4c61-9773-36132ca0db4a

	measure 'Products Any Loss Order' = "118 / 118"
		lineageTag: 18469fdf-ec33-4684-b3f2-09f6bd31d467

	measure KPI2_TrapRevenue =
			
			CALCULATE(
			    SUM(productkpis[total_revenue]),
			    productkpis[rank_divergence] < 0
			)
		lineageTag: 2b040552-cf18-49d3-8b5e-da747b884692

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure KPI2_TrapSKUCount =
			
			CALCULATE(
			    COUNTROWS(productkpis),
			    productkpis[rank_divergence] < 0
			)
		formatString: 0
		lineageTag: ade333f7-7df2-4261-9e36-4e1eb69cdc84

	measure KPI2_WorstDivergence =
			
			MIN(productkpis[rank_divergence])
		formatString: 0
		lineageTag: 5d243e2d-7788-4454-b815-534f9e39cc73

	measure KPI2_Top8ProfitShare = ```
			
			VAR Top8Profit = 
			    CALCULATE(
			        SUM(productkpis[total_profit]),
			        TOPN(8, productkpis, productkpis[total_profit], DESC)
			    )
			RETURN
			    DIVIDE(Top8Profit, SUM(productkpis[total_profit]))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 165bf9d4-7d41-4539-95fd-ed0504eb0fba

	measure Color_RankDivergence =
			
			SWITCH(
			    TRUE(),
			    MAX(productkpis[rank_divergence]) < 0, "#D85A30", // Revenue Trap (Red)
			    MAX(productkpis[rank_divergence]) > 0, "#1D9E75", // Hidden Performer (Teal)
			    "#888780" // Aligned (Gray)
			)
		lineageTag: 2d33f347-554b-4f4c-8350-78f46e9803ad

	measure 'Rank Revenue' =
			
			RANKX(ALL(DimProduct[product_name]), [Total Revenue], , DESC, Dense)
		formatString: 0
		lineageTag: d71ee75c-59c7-4b87-86ca-018c831b97d2

	measure 'Rank Profit' =
			
			RANKX(ALL(DimProduct[product_name]), [Total Profit], , DESC, Dense)
		formatString: 0
		lineageTag: 63386692-2cae-4365-8e23-b8a52d628bfd

	measure Trap_TieBreaker =
			
			MIN(productkpis[rank_divergence]) + (MIN(productkpis[revenue_rank]) / 10000)
		lineageTag: a820ccd7-6ac6-4fb1-99a8-79bc63e20c00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cumulative_Profit_Pct =
			
			VAR CurrentRank = MAX(productkpis[profit_rank])
			VAR CumulProfit = CALCULATE(SUM(productkpis[total_profit]), ALL(productkpis), productkpis[profit_rank] <= CurrentRank)
			VAR TotalProf = CALCULATE(SUM(productkpis[total_profit]), ALL(productkpis))
			RETURN DIVIDE(CumulProfit, TotalProf)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1d9bb638-5469-4256-ae60-53d27a83975a

	measure KPI3_ZombieSKUCount = ```
			
			CALCULATE(
			    COUNTROWS(QuadrantModel), 
			    QuadrantModel[quadrant] = "Cut Candidates"
			)
			```
		formatString: 0
		lineageTag: a231d832-b238-473c-94a6-9055c84aa4de

	measure KPI3_ZombieRevenueShare = ```
			
			VAR ZombieRev = 
			    CALCULATE(
			        SUM(ProductKPIs[total_revenue]), 
			        QuadrantModel[quadrant] = "Cut Candidates"
			    )
			RETURN 
			    DIVIDE(ZombieRev, SUM(ProductKPIs[total_revenue]))
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c7601f9e-c811-4d7f-9072-0681f7e62de9

	measure KPI3_AvgCompositeRisk_Cut = ```
			
			CALCULATE(
			    AVERAGE(QuadrantModel[composite_risk_score]), 
			    QuadrantModel[quadrant] = "Cut Candidates"
			)
			```
		formatString: 0.0
		lineageTag: db95c957-edae-4830-9194-d7972a2b2cc5

	measure KPI3_HighestRiskScore =
			
			MAX(QuadrantModel[composite_risk_score])
		formatString: 0.0
		lineageTag: 272aabeb-1b1c-4b34-8f3d-267bf8f4c332

	measure Label_HeroSKU = ```
			
			VAR TopGenerator = 
			    CALCULATE(
			        MAX(ProductKPIs[Product Name Short]),
			        TOPN(
			            1, 
			            FILTER(QuadrantModel, QuadrantModel[quadrant] = "Cash Generators"), 
			            CALCULATE(SUM(ProductKPIs[total_revenue])), 
			            DESC
			        )
			    )
			RETURN 
			    IF(SELECTEDVALUE(ProductKPIs[Product Name Short]) = TopGenerator, TopGenerator, BLANK())
			```
		lineageTag: ab72079e-d1f2-4927-bc62-8673cd2fcebd

	measure Chart_BubbleSize = ```
			
			IF(
			    SUM(ProductKPIs[total_revenue]) > 0, 
			    SQRT(SUM(ProductKPIs[total_revenue])), 
			    0
			)
			```
		lineageTag: 28ab99a9-7542-4415-afba-ee90e4ecd17a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Risk_TieBreaker =
			
			MIN(QuadrantModel[composite_risk_score]) + (MIN(ProductKPIs[total_revenue]) / 100000000)
		lineageTag: d192c3db-dff7-4aa1-966e-5b62add23d4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Gauge_ZombieCategoryPct =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(QuadrantModel[category_name]), QuadrantModel[quadrant] = "Cut Candidates"),
			    DISTINCTCOUNT(DimProduct[category_name])
			)
		formatString: 0%;-0%;0%
		lineageTag: aff264eb-0714-4a4c-87b6-1ec836f28985

	measure KPI4_FirstClassLateRate = ```
			
			CALCULATE(
			    [Late Delivery Rate], 
			    FactOrders[shipping_mode] = "First Class"
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: 61446d5c-888b-4590-a427-7cb25aa141a4

	measure KPI4_StandardClassLateRate = ```
			
			CALCULATE(
			    [Late Delivery Rate], 
			    FactOrders[shipping_mode] = "Standard Class"
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0ae1c6c6-ba9f-4f07-80d6-b1b5cf3af86a

	measure KPI4_AvgDiscountDependency =
			
			AVERAGE(ProductKPIs[discount_dependency_rate]) / 100
		formatString: 0%;-0%;0%
		lineageTag: d80a548a-a08e-4a0e-8eb3-bcfe20e0a656

	measure KPI4_DiscountMarginLink = "None"
		lineageTag: ae0d2c8c-ea83-43b7-b11a-158ae1db5f0d

	measure KPI5_SafeToCut =
			
			CALCULATE(
			    ABS(SELECTEDVALUE(ScenarioResults[Profit Impact ($)])),
			    ScenarioResults[Scenario] = "Scenario A: Zombie SKU Elimination"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 065ed2ab-3996-4215-b1fe-3aca7b4d11ff

	measure KPI5_CoreExposure =
			
			CALCULATE(
			    ABS(SELECTEDVALUE(ScenarioResults[Profit Impact ($)])),
			    ScenarioResults[Scenario] = "Scenario B: Core SKU Disruption"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 23eabc80-8755-427c-a5b7-ebf3326623aa

	measure KPI5_CompoundingRisk =
			
			CALCULATE(
			    ABS(SELECTEDVALUE(ScenarioResults[Profit Impact ($)])),
			    ScenarioResults[Scenario] = "Scenario C: Compounded Stress"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e833ab86-395d-40bd-9288-71235581c371

	measure KPI5_CoreReliance =
			
			DIVIDE(
			    SUM(CoreProfitDrivers[total_profit]),
			    SUM(ProductKPIs[total_profit])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 029a592f-ebf7-44ed-a148-af177b9aa31f

	measure Scenario_Dual_Label =
			
			VAR _Profit = SUM('ScenarioResults'[Projected Profit])
			VAR _Impact = SUM('ScenarioResults'[Profit Impact ($)])
			
			VAR _ProfitText = FORMAT(_Profit / 1000000, "$0.00M")
			VAR _ImpactText = IF(_Impact = 0, "", " (" & FORMAT(_Impact / 1000, "$0K") & ")")
			
			RETURN _ProfitText & _ImpactText
		lineageTag: 9b7c6d2c-496b-4aed-812d-af7be748b1fb

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

